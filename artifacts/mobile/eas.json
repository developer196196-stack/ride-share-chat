{
  "$schema": "https://json.schemastore.org/eas.json",
  "cli": {
    "version": ">= 15.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "node": "20.19.4",
      "pnpm": "10.26.1"
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "node": "20.19.4",
      "pnpm": "10.26.1",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      }
    },
    "preview-device": {
      "distribution": "internal",
      "environment": "preview",
      "node": "20.19.4",
      "pnpm": "10.26.1",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "enterpriseProvisioning": "adhoc"
      }
    },
    "production": {
      "environment": "production",
      "autoIncrement": true,
      "node": "20.19.4",
      "pnpm": "10.26.1",
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "simulator": false
      }
    }
  },
  "submit": {
    "production": {}
  }
}
