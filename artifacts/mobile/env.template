# ==============================================================================
# Rideshare Chats mobile (Expo) — copy this file to `.env` (and `.env.example`
# for the repo) and fill it in. Never commit `.env`.
# Only EXPO_PUBLIC_* variables are bundled into the app — never put secrets here.
# Restart Expo (`pnpm run mobile:clear`) after changing values.
# ==============================================================================

# ------------------------------------------------------------------------------
# API (artifacts/api-nest)
# ------------------------------------------------------------------------------
# Local Nest API. In dev the app rewrites localhost automatically:
#   Android emulator → 10.0.2.2, physical phone (Expo Go) → your PC's LAN IP.
# Use a full URL (https://…) for staging/production or an ngrok tunnel.
# On Replit leave this unset — EXPO_PUBLIC_DOMAIN is injected by scripts/dev.js.
EXPO_PUBLIC_API_URL=http://localhost:5001

# ------------------------------------------------------------------------------
# FIREBASE WEB APP CONFIG (phone sign-in)
# Firebase console → Project settings → General → Your apps → Web app → SDK config.
# These values are public identifiers, not secrets.
# ------------------------------------------------------------------------------
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# ------------------------------------------------------------------------------
# AUTH SCREEN
# ------------------------------------------------------------------------------
# Seconds before "Resend" unlocks on the verification code card (default 60).
# EXPO_PUBLIC_OTP_RESEND_SECONDS=60

# ------------------------------------------------------------------------------
# DEV TOOLS
# ------------------------------------------------------------------------------
# true = open on the Sleek screen catalogue (jump to any screen) instead of the
# splash. Dev builds only; ignored in production builds.
# EXPO_PUBLIC_SHOW_SLEEK_SCREENS=true

# true = show the ride simulator (Drive / Red light / EV stop / Walk out) on the
# Trip Validation screen, for testing on emulators and the web preview.
# The API must run with VALIDATION_ALLOW_SIMULATED=true. Dev builds only.
# EXPO_PUBLIC_ALLOW_SIMULATED_RIDE=true
