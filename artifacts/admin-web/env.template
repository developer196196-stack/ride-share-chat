# ==============================================================================
# Rideshare Chats Admin (Next.js) — copy this file to `.env` and fill it in.
# Never commit `.env`. On Replit, set these in the Secrets panel instead.
# ==============================================================================

# Same Firebase web app as the mobile app — copy the values of the matching
# EXPO_PUBLIC_FIREBASE_* variables from artifacts/mobile/.env.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

# Port of the local api-nest server that /api/* is proxied to (default 5001).
# API_PORT=5001

# ------------------------------------------------------------------------------
# One-time setup
#   1. Firebase Console → Authentication → Sign-in method → enable "Email/Password".
#   2. Create an admin (from the repo root):
#        pnpm --filter @workspace/api-nest run admin:grant -- you@example.com 'a-strong-password'
#   3. pnpm run admin  →  http://localhost:3010
# ------------------------------------------------------------------------------
