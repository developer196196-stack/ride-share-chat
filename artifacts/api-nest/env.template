# ==============================================================================
# Rideshare Chats API (NestJS) — copy this file to `.env` (and `.env.example`
# for the repo) and fill it in. Never commit `.env`.
# On Replit, set these in the Secrets panel instead.
# ==============================================================================

# ------------------------------------------------------------------------------
# SERVER
# ------------------------------------------------------------------------------
# Local API port — must match the port in EXPO_PUBLIC_API_URL (artifacts/mobile/.env).
# 5001 avoids clashing with other local APIs on 5000. On Replit the artifact sets PORT=8080.
PORT=5001

# development | production | test
NODE_ENV=development

# Comma-separated CORS origins. Empty = allow all in development only.
# CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Swagger UI at /api/docs — on by default outside production.
# SWAGGER_ENABLED=true

# Public origin used in live trip share links (e.g. https://api.ridesharechats.com).
# Defaults to the host of the incoming request.
# PUBLIC_BASE_URL=

# Accept simulated rides from the app's dev simulator (EXPO_PUBLIC_ALLOW_SIMULATED_RIDE).
# Ignored when NODE_ENV=production.
# VALIDATION_ALLOW_SIMULATED=true

# ------------------------------------------------------------------------------
# FIREBASE ADMIN SDK (required for auth, Firestore and Storage)
# Firebase console → Project settings → Service accounts → Generate new private key.
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the key on one line with literal \n line breaks, wrapped in double quotes:
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=

# Storage bucket for profile photos. Defaults to <project-id>.firebasestorage.app
# FIREBASE_STORAGE_BUCKET=

# ------------------------------------------------------------------------------
# TRIP VALIDATION ENGINE
# ------------------------------------------------------------------------------
# Thresholds — leave UNSET in production (defaults shown). Lower them only to test
# at a desk / without a real ride; the API logs a warning when any override is active.
#
#   VALIDATION_ENTRY_MPH=10            speed needed to become VERIFIED (and to recover)
#   VALIDATION_ENTRY_SUSTAIN_SEC=5     …for at least this long
#   VALIDATION_GRACE_MPH=5             below this speed the grace period starts…
#   VALIDATION_GRACE_SUSTAIN_SEC=15    …after this long (red light / traffic)
#   VALIDATION_GRACE_DURATION_SEC=300  grace period length (5 minutes)
#   VALIDATION_VERIFIED_SCORE=80       score needed for VERIFIED (0–100)
#   VALIDATION_GRACE_SCORE=50          lower edge of the GRACE band
#   VALIDATION_WEIGHT_GPS=0.40         module weights (normalised to add up to 1)
#   VALIDATION_WEIGHT_VIBRATION=0.25
#   VALIDATION_WEIGHT_GROUND_TRUTH=0.35
#   VALIDATION_NEUTRAL_MODULE_SCORE=50 score for a module with no data
#   VALIDATION_MAX_GPS_ACCURACY_M=50   ignore GPS fixes less accurate than this
#   VALIDATION_WALKING_SUSTAIN_SEC=20  walking this long = left the vehicle
#   VALIDATION_SIGNAL_LOST_SEC=60      no telemetry this long → grace
#   VALIDATION_SPOOF_CHECKS=true       mock GPS / teleport / emulator / no-vehicle-signal checks
#
#   Fine tuning (the same rules, every number is overridable; restart the API after editing):
#   VALIDATION_LOW_SCORE_SUSTAIN_SEC=10      score under the VERIFIED band this long → GRACE, even while moving
#   VALIDATION_SCORE_SMOOTHING=0.5           weight of the newest sample in the score (0.01–1; lower = steadier)
#   VALIDATION_VIBRATION_BAND_FLOOR=0.12     10–25 Hz energy ratio that scores 0 …
#   VALIDATION_VIBRATION_BAND_CEIL=0.4       … and the ratio that scores 100
#   VALIDATION_WALKING_REJECT_ABOVE=0.6      walking-cadence score above this rejects vibration (and counts as on foot)
#   VALIDATION_SHAKE_REJECT_ABOVE=0.6        hand-shake score above this rejects vibration
#   VALIDATION_ACTIVITY_MIN_CONFIDENCE=50    ignore OS activity below this confidence (0–100)
#   VALIDATION_ACTIVITY_STILL_SCORE=40       ground-truth points for "still" (a stopped car)
#   VALIDATION_ROADS_RECHECK_SEC=180         re-run Google Roads matching this often
#   VALIDATION_ROADS_MIN_FIXES=3             GPS fixes needed for a road check
#   VALIDATION_ROADS_MAX_FIXES=20            most recent fixes sent to the road check
#   VALIDATION_ROADS_MATCHED_RATIO_MIN=0.6   share of fixes that must snap to a road
#   VALIDATION_ROADS_MEAN_OFFSET_MAX_M=25    mean distance from the road allowed
#   VALIDATION_TELEPORT_MPS=72               implied speed between fixes above this = spoofing (~160 mph)
#   VALIDATION_SUSPICION_SUSTAIN_SEC=30      fast with no vibration / vehicle activity this long = suspicious
#   VALIDATION_SUSPICION_PENALTY=25          score points removed while suspicious
#
# Desk-testing preset (sitting still, phone on the table):
# VALIDATION_ENTRY_MPH=0
# VALIDATION_ENTRY_SUSTAIN_SEC=2
# VALIDATION_GRACE_MPH=0
# VALIDATION_VERIFIED_SCORE=30
# VALIDATION_SPOOF_CHECKS=false

# How long "Next" keeps skipped riders from re-matching, in seconds (default 3600).
# While testing with two devices set a small value (e.g. 30), otherwise tapping Next once
# puts your two test accounts in separate R.O.O.M.s for an hour. 0 disables blocking.
# ROOM_SKIP_BLOCK_SEC=30

# Google Roads API key (Snap to Roads) — server-side only, restrict it to "Roads API".
# GOOGLE_ROADS_API_KEY=

# ------------------------------------------------------------------------------
# REALTIME STATE — Redis connection string.
#   Upstash: rediss://default:<password>@<name>.upstash.io:6379  (TLS)
#   Local (e.g. Laragon): redis://localhost:6379
# ------------------------------------------------------------------------------
# REDIS_URL=

# ------------------------------------------------------------------------------
# VIDEO R.O.O.M.s (Phase 6) — LiveKit Cloud → Settings → API Keys
# ------------------------------------------------------------------------------
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
